# Crewfi server settings. Copy to .env (or set them in your host's dashboard).

# paper = simulated SOL against live prices (safe default). live = REAL SOL on mainnet.
MODE=paper
PORT=3000
SITE_URL=https://your-domain.example

# --- needed for MODE=live ---------------------------------------------------
# A paid RPC (Helius, Triton, QuickNode...). The public one rate-limits quickly.
RPC_URL=https://api.mainnet-beta.solana.com
# Long random secret that encrypts every builder wallet key. Back it up: lose it
# and the builder wallets cannot be opened. Generate: openssl rand -hex 32
MASTER_KEY=

# --- optional ---------------------------------------------------------------
# Your platform token (turns on skins, paid in this token) and the wallet that receives payments.
TOKEN_MINT=
TOKEN_SYMBOL=CREW
TREASURY_WALLET=
X_URL=
MIN_CAPITAL_SOL=0.2
PAPER_START_SOL=1
TRADING_ENABLED=true
LAUNCH_ENABLED=true
DATA_DIR=data
